# Optional public RPC. Never put private keys in NEXT_PUBLIC_ variables.
MONAD_RPC_URL=https://rpc.monad.xyz
# Read-only integration only. Set AFTER reviewed, explicitly approved deployment.
# No contract is deployed now. The API checks genesis() against the real collection.
# This is server-only; no wallet key or seed is needed by this application.
MEMORY_LEDGER_ADDRESS=
# DEFAULT OFF. Only a human may enable after reviewed deployment AND real-holder
# testing approval. This is not approval to deploy or transact. Never set casually.
MEMORY_WRITES_APPROVED=false
